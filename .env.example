# ---------------------------------------------------------------------------
# SetupVault environment variables
# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API). Never commit .env.local.
# ---------------------------------------------------------------------------

# Required. Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Required. The "anon" / "publishable" key. This one is safe in the browser:
# it only works in combination with Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for account deletion only (Settings -> Delete account).
# The "service_role" / "secret" key BYPASSES Row Level Security.
# Server-side only. Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The public origin used to build the links in Supabase auth emails.
# Defaults to http://localhost:3000 in development.
# Set this to your real domain in production, e.g. https://setupvault.com
NEXT_PUBLIC_SITE_URL=

# --- AI (Phase 6) ------------------------------------------------------------
# Which provider answers. "gemini" is the selected provider.
#   gemini    Google Gemini via Google AI Studio (the official @google/genai SDK)
#   anthropic Kept as a second real implementation, so the provider
#             abstraction is exercised by more than one thing
#   mock      Full, schema-valid responses with no API key and no cost.
#             Development and automated tests only.
#
# A missing or misconfigured real provider FAILS. It never falls back to the
# mock: output that looks like a model read your chart when nothing did is
# worse than an error message.
AI_PROVIDER=gemini

# --- Google Gemini -----------------------------------------------------------
# Required when AI_PROVIDER=gemini. Create one at https://aistudio.google.com
# (Get API key). Server-side only. NEVER prefix with NEXT_PUBLIC_ — anything
# with that prefix is inlined into the JavaScript every visitor downloads.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
#
# Whatever you set here must support image input and structured output, or
# chart analysis and OCR will fail. Verified for gemini-3.8-flash on
# 2026-11-02: inputs text/image/video/audio/PDF, structured outputs
# supported, 1,048,576 input and 65,536 output tokens.
GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic (alternative provider) ----------------------------------------
# Required only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=

# --- Generic fallbacks -------------------------------------------------------
# Read when the provider-specific names above are unset, so an existing
# deployment keeps working across this change instead of failing on the first
# request after a deploy. Prefer the specific names for anything new.
AI_API_KEY=
AI_MODEL=

# Mock-only knobs, for exercising loading and error states:
#   AI_MOCK_DELAY_MS=900
#   AI_MOCK_FAILURE=timeout | rate_limited | provider_error | unauthorized
#                 | invalid_output | ocr_mismatch | ocr_ambiguous
